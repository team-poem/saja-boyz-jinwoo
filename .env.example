# /incidents 서버가 읽는 뉴스 API의 HTTP(S) 기준 주소입니다.
# .env.local에 설정하거나 실행 환경에서 전달합니다. NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
# 미설정·잘못된 주소이면 목록에 오류와 다시 시도 링크를 표시합니다.
NEWS_API_BASE_URL=https://poem-news.168.107.37.12.sslip.io

# 네이버 Maps Dynamic Map의 웹용 Client ID. 실제 값은 .env.local 또는 배포 환경에 설정합니다.
# NEXT_PUBLIC 값은 빌드 때 브라우저 코드에 포함됩니다. Client Secret은 사용하지 않습니다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
